{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameDist",
  "mainBinaryName": "gamedist-launcher",
  "version": "0.1.0",
  "identifier": "org.gamedist.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "GameDist",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: http: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Open, decentralized game launcher",
    "longDescription": "Install, update and launch games from any GameDist server. Releases are verified against the developer's signing key.",
    "copyright": "MIT License",
    "license": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "deb": { "depends": [] }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["gamedist", "gamedist+http"]
      }
    }
  }
}
