{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamedist.org/schemas/v0/game-manifest.schema.json",
  "title": "GameDist game manifest",
  "type": "object",
  "required": ["protocol", "game_id", "slug", "developer_pubkey", "title", "channels", "releases"],
  "properties": {
    "protocol": { "const": "gamedist/0" },
    "game_id": { "type": "string", "pattern": "^[a-z2-7]{26}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "developer_pubkey": { "type": "string", "pattern": "^ed25519:[A-Za-z0-9_-]{43}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "summary": { "type": "string", "maxLength": 300 },
    "description_md": { "type": "string", "maxLength": 100000 },
    "assets": {
      "type": "object",
      "properties": {
        "icon": { "$ref": "#/$defs/chunkId" },
        "banner": { "$ref": "#/$defs/chunkId" },
        "screenshots": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/chunkId" } }
      }
    },
    "channels": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
      "additionalProperties": { "type": "string" }
    },
    "releases": { "type": "string", "pattern": "^https?://.*/$" },
    "rotations": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "chunkId": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
