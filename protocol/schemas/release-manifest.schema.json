{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamedist.org/schemas/v0/release-manifest.schema.json",
  "title": "GameDist release manifest",
  "type": "object",
  "required": ["protocol", "game_id", "slug", "version", "created", "platforms", "developer_pubkey", "sig"],
  "properties": {
    "protocol": { "const": "gamedist/0" },
    "game_id": { "type": "string", "pattern": "^[a-z2-7]{26}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[0-9A-Za-z.-]+$" },
    "created": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "changelog_md": { "type": "string", "maxLength": 100000 },
    "platforms": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9]+-[a-z0-9_]+$" },
      "additionalProperties": { "$ref": "#/$defs/platform" }
    },
    "developer_pubkey": { "type": "string", "pattern": "^ed25519:[A-Za-z0-9_-]{43}$" },
    "sig": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  },
  "$defs": {
    "platform": {
      "type": "object",
      "required": ["launch", "files", "total_size"],
      "not": { "required": ["encoding"] },
      "properties": {
        "launch": {
          "type": "object",
          "required": ["exe"],
          "properties": {
            "exe": { "type": "string", "minLength": 1 },
            "args": { "type": "array", "items": { "type": "string" } },
            "cwd": { "type": "string", "minLength": 1 }
          }
        },
        "files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
        "total_size": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "file": {
      "type": "object",
      "required": ["path", "size", "mode", "chunks"],
      "not": { "required": ["encoding"] },
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "size": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "mode": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "chunks": { "type": "array", "items": { "$ref": "#/$defs/chunk" } }
      }
    },
    "chunk": {
      "type": "object",
      "required": ["id", "size"],
      "not": { "required": ["encoding"] },
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 8388608 }
      }
    }
  }
}
