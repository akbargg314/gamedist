# nginx reverse proxy for gamedist-server.
#
# gamedist-server should listen on 127.0.0.1:8080 with
#   public_url  = "https://games.example.org"
#   trust_proxy = true
# The server uses the right-most X-Forwarded-For entry as the client address,
# which is what $proxy_add_x_forwarded_for appends.
#
# Obtain certificates with e.g. certbot (`certbot --nginx -d games.example.org`).

upstream gamedist {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name games.example.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name games.example.org;

    ssl_certificate     /etc/letsencrypt/live/games.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/games.example.org/privkey.pem;

    # Release manifests can be up to 64 MiB and chunks up to 8 MiB.
    client_max_body_size 80m;

    # Stream uploads and downloads instead of buffering them on disk.
    proxy_request_buffering off;
    proxy_buffering off;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    # Optional: keep Prometheus metrics private.
    # location = /metrics {
    #     allow 127.0.0.1;
    #     deny all;
    #     proxy_pass http://gamedist;
    # }

    location / {
        proxy_pass http://gamedist;
    }
}
