# Copy to deploy/.env and edit. Used by docker-compose.yml.

# Public host name. DNS must point at this machine and ports 80/443 must be
# reachable so Caddy can obtain a certificate.
GAMEDIST_DOMAIN=games.example.org

# Name shown in the portal and in /.well-known/gamedist.json.
GAMEDIST_NAME=GameDist server

# Initial registration mode: open | invite | closed. Once an admin changes it
# in the /admin portal page, the stored setting wins over this value.
GAMEDIST_REGISTRATION=closed

# Image to run. Leave the default to build locally, or use a published image
# such as ghcr.io/<owner>/gamedist-server:<version>.
GAMEDIST_IMAGE=gamedist-server:local

RUST_LOG=info
